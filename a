user www;

worker_processes auto;

error_log /var/log/nginx/error.log warn;

include /etc/nginx/modules/*.conf;

events {
	worker_connections 1024;
}

http {
	include /etc/nginx/mime.types;
	default_type application/octet-stream;

	access_log /var/log/nginx/access.log main;

	sendfile on;
	tcp_nopush on;
	tcp_nodelay on;
	keepalive_timeout 65;
	types_hash_max_size 2048;

	# SSL Configuration
	ssl_protocols TLSv1.2 TLSv1.3;

	# Include server configurations
	include /etc/nginx/conf.d/*.conf;
}


#!/bin/bash

RESET='\033[0m'
BLUE='\033[0;34m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'

echo -e "${BLUE}Setting up NGINX with SSL...${RESET}"

# Create SSL directory if it doesn't exist
mkdir -p /etc/ssl/certs
mkdir -p /etc/ssl/private

# Generate self-signed SSL certificate
if [ ! -f /etc/ssl/certs/nginx-selfsigned.crt ]; then
	echo -e "${YELLOW}Generating SSL certificate...${RESET}"
	openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
		-keyout /etc/ssl/private/nginx-selfsigned.key \
		-out /etc/ssl/certs/nginx-selfsigned.crt \
		-subj "/C=TR/ST=Istanbul/L=Istanbul/O=42/OU=42/CN=ulyildiz.42.fr"
	
	# Set proper permissions
	chmod 600 /etc/ssl/private/nginx-selfsigned.key
	chmod 644 /etc/ssl/certs/nginx-selfsigned.crt
	
	echo -e "${GREEN}SSL certificate generated successfully${RESET}"
fi

# Create nginx configuration directory
mkdir -p /etc/nginx/conf.d

# The default.conf file should be copied during docker build
# Check if it exists, if not create a basic one
if [ ! -f /etc/nginx/conf.d/default.conf ]; then
	echo -e "${YELLOW}Default configuration not found, this should be handled by Dockerfile${RESET}"
fi

# Create web directory
mkdir -p /var/www/html
chown -R www:www /var/www/html

# Test nginx configuration
echo -e "${YELLOW}Testing NGINX configuration...${RESET}"
nginx -t

if [ $? -eq 0 ]; then
	echo -e "${GREEN}NGINX configuration is valid${RESET}"
else
	echo -e "${RED}NGINX configuration has errors${RESET}"
	exit 1
fi

echo -e "${GREEN}NGINX setup completed successfully${RESET}"

exec "$@"



# HTTP server - redirect to HTTPS
server {
	listen 443;
	listen [::]:443;
	
	server_name ulyildiz.42.fr;
	
	# Redirect all HTTP traffic to HTTPS
	#return 301 https://$server_name$request_uri;

	return 444;
} ## We cant directly delete http it will get connection refused error

# HTTPS server
server {
	listen 443 ssl http2;
	listen [::]:443 ssl http2;

	server_name ulyildiz.42.fr;

	# SSL certificate paths
	ssl_certificate /etc/ssl/certs/nginx-selfsigned.crt;
	ssl_certificate_key /etc/ssl/private/nginx-selfsigned.key;

	# SSL configuration
	ssl_protocols TLSv1.2 TLSv1.3;

	root /var/www/html;

	index index.html index.htm index.php;

	# 
	location / {
		try_files $uri $uri/ /index.php?$args;
	}

	# Deny access to hidden files
	location ~ /\. {
		deny all;
	}

	# Deny access to wp-config.php
	location ~* wp-config.php {
		deny all;
	}
}
